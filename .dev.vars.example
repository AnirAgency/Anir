# Local secrets for `wrangler dev`: copy to .dev.vars (gitignored) and fill in.
# In production these are Worker secrets — `npx wrangler secret put <NAME>` or
# Workers & Pages > anir > Settings > Variables and Secrets. Never commit them.
#
# SUPABASE_URL is public and lives in wrangler.jsonc under "vars".

# Service role key. Bypasses row level security, so it is the ONLY way to write
# to `enquiries` — and the reason it must never reach the browser. It is read
# solely by worker/enquiry.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The health check's credential (scripts/test-headers.mjs sends it as
# X-Health-Check). With it, a POST to /api/enquiry is answered and stored
# nowhere; without it, every POST is an enquiry. Any long random string; set
# the same value in the shell that runs the check: HEALTH_CHECK_SECRET=… .
HEALTH_CHECK_SECRET=

# The team's Telegram (worker/enquiry.ts > tell): the bot's token and the chat
# it posts to. Set both to hear an enquiry from `wrangler dev` — the same
# message production sends. Leave empty and the Worker logs "no channel".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
