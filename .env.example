# Cloudflare Pages > Settings > Environment variables.
# Never commit real values — .env is gitignored, this file is the template.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key. Bypasses row level security, so it is the ONLY way to write
# to `enquiries` — and the reason it must never reach the browser. It is read
# solely by functions/api/enquiry.ts, which runs on the edge.
SUPABASE_SERVICE_ROLE_KEY=
