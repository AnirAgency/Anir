# build
dist/
.astro/
node_modules/

# env / secrets — Supabase keys live in the Cloudflare dashboard
.env
.env.*
!.env.example

# cloudflare
.wrangler/

# font pipeline (re-creatable with `npm run fonts`)
tools/.venv/
tools/fonts-src/

# raw media, before `npm run media` (Phase 08). Camera originals never ship;
# only the processed output in public/media/ does.
raw-media/*
!raw-media/README.md

# screenshots written by AI design sessions — reference, not source
Claude outputs/

# os
.DS_Store
Thumbs.db

# Written by scripts/headers.mjs on every build; the Worker imports it.
worker/*.generated.json

# Local Worker secrets for `wrangler dev` (copy .dev.vars.example).
.dev.vars

# Written by scripts/content-pull.mjs before every build: the admin's content
# and the images it uploaded, pulled from Supabase. Never committed.
src/content/live.json
public/media/live/

# Generated: the proofreading list (npm run copy:export), and the CI wrapper's scratch files (npm run ci).
mongolian-copy*.md
.build-log
.build-exit
