{
  "name": "anir-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/content-pull.mjs && astro build && node scripts/headers.mjs",
    "preview": "astro preview",
    "budget": "npm run build && node scripts/budget.mjs && node scripts/budget-pages.mjs && node scripts/contrast.mjs && node scripts/seo.mjs && node scripts/media.mjs --check && node scripts/no-placeholders.mjs",
    "ci": "node scripts/build-report.mjs start || true; { npm run budget; echo $? > .build-exit; } 2>&1 | tee .build-log; code=$(cat .build-exit 2>/dev/null || echo 1); node scripts/build-report.mjs \"$code\" .build-log || true; exit \"$code\"",
    "fonts": "node scripts/fonts.mjs",
    "shot": "node scripts/shot.mjs",
    "test:enquiry": "node scripts/test-enquiry.ts",
    "media": "node scripts/media.mjs",
    "test:media": "node scripts/test-media.mjs",
    "contrast": "node scripts/contrast.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run budget && wrangler deploy",
    "test:headers": "node scripts/test-headers.mjs",
    "predev": "node scripts/content-pull.mjs",
    "postinstall": "node scripts/content-pull.mjs --ensure",
    "test:publish": "node scripts/test-publish.ts",
    "pretest:enquiry": "node scripts/content-pull.mjs --ensure",
    "pretest:publish": "node scripts/content-pull.mjs --ensure",
    "test:inbox": "node scripts/test-inbox.ts",
    "pretest:inbox": "node scripts/content-pull.mjs --ensure",
    "labels": "node scripts/admin-labels.ts",
    "seo": "node scripts/seo.mjs",
    "migration:record": "node scripts/migration-record.mjs",
    "prelabels": "node scripts/content-pull.mjs --ensure",
    "copy:export": "node scripts/copy-export.ts",
    "precopy:export": "node scripts/content-pull.mjs",
    "test:builds": "node scripts/test-builds.ts",
    "test:watch": "node scripts/test-watch.ts",
    "test:tasks": "node scripts/test-tasks.ts",
    "test:isolation": "node scripts/test-isolation.ts",
    "test:tasks-browser": "node scripts/test-tasks-browser.mjs",
    "test:contributions": "node scripts/test-contributions.ts",
    "test:contributions-browser": "node scripts/test-contributions-browser.mjs",
    "pretest:watch": "node scripts/content-pull.mjs --ensure",
    "pretest:builds": "node scripts/content-pull.mjs --ensure",
    "grain": "node scripts/grain.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "lenis": "^1.1.13"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "wrangler": "4.152.0"
  }
}
