---
import { site } from '../content/site';

/*
  Fixed top bar on a solid --ink ground, at every scroll position.

  Solid rather than see-through: content scrolling under a transparent bar
  collides with the nav labels, and a backdrop blur would re-blur the strip on
  every frame of scrolling — on a budget Android already running Lenis and the
  scroll-driven animations — for a blur that is barely visible over a dark
  page anyway. A flat fill costs nothing.

  On --ink the CTA's --orange is 5.43:1 wherever the page is scrolled, so it no
  longer needs to know what is underneath it: the old blended layer, the
  width-holding ghost and the tone-tracking script are all gone.
*/

const { navLabel } = site.chrome;
const links = site.nav.links.filter((link) => !link.accent);
const cta = site.nav.links.find((link) => link.accent);
---

<header class="header">
  <a class="header__mark t-display-s" href="#top">{site.nav.wordmark}</a>

  <nav class="header__nav" aria-label={navLabel}>
    <ul class="header__list">
      {
        links.map((link) => (
          <li>
            <a class="header__link t-mono-label" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      cta && (
        <a class="header__cta t-mono-label" href={cta.href}>
          {cta.label}
        </a>
      )
    }
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-h);
    padding-left: var(--inset);
    padding-right: var(--inset-right);
    background: var(--ink);
    color: var(--paper);
  }

  /*
    The bar sits above the film grain (base.css > body::after), so it carries
    its own copy: without it the bar reads darker than the grained page below.
    Both tiles start at the viewport origin, so the two line up pixel for
    pixel.
  */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--grain-image);
    background-size: 96px 96px;
    opacity: var(--grain-opacity);
  }

  .header__mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Widen the hit area to 44px without moving the wordmark off the inset. */
    min-width: 44px;
    padding-inline: 3px;
    margin-inline: -3px;
    letter-spacing: 0.14em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin: 0;
  }

  .header__link,
  .header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    transition: color 0.3s ease;
  }

  .header__link:hover {
    color: var(--dim);
  }

  .header__cta {
    color: var(--orange);
  }

  .header__cta:hover {
    color: var(--paper);
  }

  @media (max-width: 860px) {
    .header {
      padding-left: var(--inset-mobile);
      padding-right: var(--inset-mobile);
    }

    .header__nav,
    .header__list {
      gap: 0.5rem;
    }

    /*
      Two plain links fit beside the wordmark and the CTA at 375: the first two
      in site.ts, Үйлчилгээ and Ажил. Any further link is dropped here rather
      than wrapping the bar.
    */
    .header__list li:nth-child(n + 3) {
      display: none;
    }

    .header__mark {
      letter-spacing: 0.08em;
    }

    .header__link,
    .header__cta {
      letter-spacing: 0.1em;
    }
  }
</style>
