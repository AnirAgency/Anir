---
import { site } from '../content/site';

/*
  Fixed top bar: the words alone, no ground, by the owner's direction. It
  gets out of the way — scrolling down slides it up out of sight, scrolling
  up brings it back — and is always there at the top of the page and
  whenever something in it has keyboard focus.

  With no ground of its own it takes the tone of the section under it: --paper
  words over a dark section, --ink over a light one. On light, the orange
  links become --ink with a 2px orange rule under them, because orange as
  small text on --paper fails (CLAUDE.md > Contrast). The script below
  tracks the section; without JS the bar keeps a solid --ink ground and
  needs no tracking, as it always did.

  Over photographs and the silk the words can land on busy ground; that is
  the cost of having no bar. No backdrop blur: it would re-blur the strip on
  every frame of scrolling.
*/

interface Props {
  /** False on a page that does not hold the home page's sections — the
   *  products pages — where its anchors lead back to the home page. */
  home?: boolean;
}

const { home = true } = Astro.props;
const { navLabel } = site.chrome;
const links = site.nav.links.filter((link) => !link.accent);
const cta = site.nav.links.find((link) => link.accent);

const to = (href: string) => (!home && href.startsWith('#') ? `/${href}` : href);
// A link to a page is current on that page and everything under it.
const current = (href: string) => (href.startsWith('/') && Astro.url.pathname.startsWith(href) ? 'page' : undefined);
---

<header class="header">
  <a class="header__mark t-display-s" href={home ? '#top' : '/'}>{site.nav.wordmark}</a>

  <nav class="header__nav" aria-label={navLabel}>
    <ul class="header__list">
      {
        links.map((link) => (
          <li>
            <a class="header__link t-mono-label" href={to(link.href)} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      cta && (
        <a class="header__cta t-mono-label" href={to(cta.href)}>
          {cta.label}
        </a>
      )
    }
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-h);
    padding-left: var(--inset);
    padding-right: var(--inset-right);
    background: var(--ink);
    color: var(--paper);
    transition:
      translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      color 0.3s ease;
  }

  /* With JS: no ground, and out of the way while reading down the page. */
  :global(html.js) .header {
    background: transparent;
  }

  .header.is-hidden {
    translate: 0 -100%;
  }

  .header:focus-within {
    translate: none;
  }

  .header__mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Widen the hit area to 44px without moving the wordmark off the inset. */
    min-width: 44px;
    padding-inline: 3px;
    margin-inline: -3px;
    letter-spacing: 0.14em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin: 0;
  }

  .header__link,
  .header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    transition: color 0.3s ease;
  }

  /* The page you are on is the live link. */
  .header__link[aria-current='page'] {
    color: var(--orange);
  }

  .header__link:hover {
    color: var(--dim);
  }

  .header__cta {
    color: var(--orange);
  }

  .header__cta:hover {
    color: var(--paper);
  }

  /* Over a light section. */
  .header[data-tone='light'] {
    color: var(--ink);
  }

  .header[data-tone='light'] .header__link:hover {
    color: var(--dim-2);
  }

  .header[data-tone='light'] .header__link[aria-current='page'],
  .header[data-tone='light'] .header__cta {
    color: var(--ink);
    text-decoration: underline 2px var(--orange);
    text-underline-offset: 0.55em;
  }

  .header[data-tone='light'] .header__cta:hover {
    color: var(--dim-2);
  }

  @media (max-width: 860px) {
    .header {
      padding-left: var(--inset-mobile);
      padding-right: var(--inset-mobile);
    }

    .header__nav,
    .header__list {
      gap: 0.5rem;
    }

    /*
      Two plain links fit beside the wordmark and the CTA at 375: the first two
      in site.ts, Үйлчилгээ and Ажил. Any further link is dropped here rather
      than wrapping the bar.
    */
    .header__list li:nth-child(n + 3) {
      display: none;
    }

    .header__mark {
      letter-spacing: 0.08em;
    }

    .header__link,
    .header__cta {
      letter-spacing: 0.1em;
    }
  }
</style>

<script>
  /*
    The tone: whichever section crosses a band along the top of the screen —
    where the bar sits — sets it. The footer counts as dark.

    Hiding: down past the bar's own height hides it, any scroll up brings it
    back. A few pixels of slack, so a trackpad's jitter cannot flicker it.
  */
  const header = document.querySelector<HTMLElement>('.header');
  if (header) {
    const tone = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            header.dataset.tone = entry.target.classList.contains('section--light') ? 'light' : 'dark';
          }
        }
      },
      { rootMargin: '0px 0px -95% 0px' }
    );
    document.querySelectorAll('[data-section], .footer').forEach((el) => tone.observe(el));

    let last = scrollY;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (Math.abs(y - last) < 8) return;
        header.classList.toggle('is-hidden', y > last && y > header.offsetHeight);
        last = y;
      },
      { passive: true }
    );
  }
</script>
