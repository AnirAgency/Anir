---
import Grid from './Grid.astro';
import Section from './Section.astro';
import { site } from '../content/site';
import { resolveMark, resolveVideo } from '../lib/media';

// Inlined, not <img>, because the mark takes its colour from currentColor —
// an external file cannot inherit --orange.
import logo from '../../public/media/logo.svg?raw';

const { hero, chrome } = site;

/*
  The hero loop is optional. Until the shoot happens the slot renders as a bare
  plate, so the build never depends on an asset that does not exist. Which
  encodes are actually present is read off disk at build time, not trusted from
  site.ts, so a missing file shows up here instead of as a 404 in Ulaanbaatar.
*/
const heroVideo = hero.video ? resolveVideo(hero.video) : null;

/*
  The 3D N. What renders here is the still — the centre frame — as a plain
  background, so it paints with no JavaScript, and phones, crawlers and
  reduced-motion visitors never get anything else. The box is reserved by
  aspect-ratio, taken from the sheet's own cell size, so nothing shifts later.

  The sheet is a yaw-only strip: one row, every frame at pitch 0. Pitch is CSS
  alone (see the script), so a grid with pitch rows would be silently wrong —
  fail the build instead.
*/
const mark = hero.mark ? resolveMark(hero.mark.name) : null;
if (mark && mark.grid.rows !== 1) {
  throw new Error(`${hero.mark?.name}.json has ${mark.grid.rows} rows; the hero tilt expects a yaw-only strip (rows: 1).`);
}
const markStyle = mark
  ? `background-image: url(${mark.still}); --mark-ratio: ${mark.grid.cell[0]} / ${mark.grid.cell[1]};`
  : undefined;
---

<Section tone="dark" id="hero" label={chrome.heroLabel} layout="hero" heading={false} seam>
  <div class="hero">
    <div class="hero__top">
      <div class="hero__stage">
        <div class="hero__media" aria-hidden="true">
          {
            heroVideo?.present && hero.video ? (
              <video
                class="hero__video"
                poster={heroVideo.fallback ?? undefined}
                width={hero.video.width}
                height={hero.video.height}
                aria-label={hero.video.alt}
                muted
                playsinline
                loop
                autoplay
                preload="none"
              >
                {heroVideo.sources.map((source) => (
                  <source src={source.src} type={source.type} />
                ))}
              </video>
            ) : (
              /* No label: it would sit on the wordmark at narrow widths, and a
                 placeholder string must never ship. The build report says which
                 asset is missing. */
              <div class="hero__plate" />
            )
          }
        </div>

        <h1 class="hero__logo">
          <span class="visually-hidden">{hero.logoAlt}</span>
          <Fragment set:html={logo} />
        </h1>
      </div>

      {
        mark && (
          <div
            class="hero__mark"
            aria-hidden="true"
            style={markStyle}
            data-mark
            data-lazy={mark.sheet ?? undefined}
            data-yaw={JSON.stringify(mark.grid.yawDeg)}
          >
            {/* Two frames of the same sheet, cross-faded. Empty until the
                sheet has decoded; the still on the parent shows until then. */}
            <div class="hero__mark-layer" data-mark-layer />
            <div class="hero__mark-layer" data-mark-layer />
          </div>
        )
      }

      <p class="hero__tagline t-serif-display">
        {hero.tagline.line}
        <em class="hero__tagline-italic">{hero.tagline.lineItalic}</em>
      </p>

      <p class="hero__lede t-mono-body">{hero.lede}</p>
    </div>

    <div class="hero__products">
      <Grid cols={3}>
        {
          hero.products.map((product) => (
            <a class="card" href={product.href}>
              <span class="card__eyebrow t-mono-label">{product.eyebrow}</span>
              <span class="card__name t-display-m">{product.name}</span>
              <span class="card__tagline t-mono-spec">{product.tagline}</span>
              <span class="card__cta t-mono-label">{product.cta}</span>
            </a>
          ))
        }
      </Grid>
    </div>
  </div>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
  }

  /*
    One column, centred, with the N above the wordmark. Two columns from
    861px — see the media query below. At one column the N is always the
    still: the script's gate uses the identical query, so the sheet is never
    requested for a collapsed mark.

    The N never goes past 280 CSS px. The cells are 600px native, so even on a
    2× screen 280px is 560 device px and nothing is upscaled — soft glass edges
    are exactly what gives a pre-rendered mark away.
  */
  .hero__top {
    --mark-w: clamp(180px, 20.5vw, 280px);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    row-gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    width: 100%;
    text-align: center;
  }

  /*
    Holds the logo and the footage behind it in one stacking box. The stage is
    sized to the wordmark, not to the section, so the media's bleed is measured
    against the mark — sized to the section it overran the page by 56px.
  */
  .hero__stage {
    grid-row: 2;
    position: relative;
    width: min(78vw, 660px);
  }

  .hero__mark {
    grid-row: 1;
    position: relative;
    width: var(--mark-w);
    aspect-ratio: var(--mark-ratio);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  /*
    The two frames. The script gives them the sheet once it has decoded; until
    then they are empty and the still on the parent shows through. The tilt's
    transform is only ever on the parent, never on a layer — that is what keeps
    the two frames in register, so the blend is an interpolation, not a ghost.
  */
  .hero__mark-layer {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
  }

  /* Set by the script once the sheet has decoded and the tilt is running. */
  .hero__mark.is-live {
    will-change: transform;
    /* The blend below must only see the two frames, never the page. */
    isolation: isolate;
  }

  .hero__mark.is-live .hero__mark-layer {
    will-change: opacity;
  }

  /*
    A true cross-fade. The glass is partly transparent, so plain "B over A"
    never reaches frame B: at full opacity A still shows through B's glass, then
    vanishes when the pair advances — a visible step at every boundary. With A
    at 1 − t and B added on top (plus-lighter sums premultiplied colour), the
    result is exactly A·(1 − t) + B·t: frame B itself at t = 1, so advancing
    the pair changes nothing on screen.
  */
  .hero__mark-layer + .hero__mark-layer {
    mix-blend-mode: plus-lighter;
  }

  .hero__logo {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    margin: 0;
    color: var(--orange);
  }

  .hero__logo :global(svg) {
    width: 100%;
    height: auto;
  }

  /*
    Sits behind the mark, a little wider than it, and is held back so the
    wordmark stays the thing you read first.
  */
  .hero__media {
    position: absolute;
    /* Tracks the wordmark's box with a small bleed, so the footage reads as a
       band behind the mark rather than a panel cutting across the tagline. */
    inset: -14% -9%;
    overflow: hidden;
    opacity: 0.4;
    pointer-events: none;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Until the loop exists, the slot is the section ground itself — no grey
     box behind the mark. */
  .hero__plate {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--bg);
  }

  .hero__tagline {
    text-wrap: balance;
  }

  .hero__tagline-italic {
    display: block;
    font-style: italic;
  }

  .hero__lede {
    max-width: 60ch;
    color: var(--muted);
  }

  /*
    Two columns: the wordmark, tagline and lede on the left, the 3D N on the
    right; the product cards run full width below. One rule sets the layout:
    the bottom of the N sits level with the bottom of the AGENCY line. Both
    are in the first row and the row aligns to its end. The N is taller than
    the wordmark, so its top rises above it — that lift is what keeps it from
    reading as a bullet beside the type, and it falls out of the alignment.

    This query string is also the script's gate, character for character —
    change one, change both.
  */
  @media (min-width: 861px) {
    .hero__top {
      grid-template-columns: minmax(0, 660px) minmax(var(--mark-w), 1fr);
      align-items: end;
      justify-items: stretch;
      column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      text-align: start;
    }

    .hero__stage {
      grid-column: 1;
      grid-row: 1;
      width: auto;
    }

    .hero__mark {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
    }

    .hero__tagline,
    .hero__lede {
      grid-column: 1;
    }
  }

  .hero__products {
    width: 100%;
    margin-top: clamp(1rem, 0.25rem + 3vw, 2.5rem);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.375rem;
    transition:
      background 0.35s ease,
      color 0.35s ease;
  }

  .card__eyebrow,
  .card__tagline {
    color: var(--muted);
    transition: color 0.35s ease;
  }

  .card__cta {
    margin-top: 1.25rem;
    color: var(--muted);
    transition: color 0.35s ease;
  }

  /*
    Hover fills the cell with --plate and turns the whole card --orange. Colour
    and background only — CLAUDE.md rules out transforms on hover.
  */
  .card:hover,
  .card:focus-visible {
    background: var(--plate);
    color: var(--orange);
  }

  .card:hover .card__eyebrow,
  .card:hover .card__tagline,
  .card:hover .card__cta,
  .card:focus-visible .card__eyebrow,
  .card:focus-visible .card__tagline,
  .card:focus-visible .card__cta {
    color: var(--orange);
  }

  @media (max-width: 860px) {
    .card {
      padding: 1.125rem;
    }
  }
</style>

<script>
  /*
    The tilt. Enhancement only: the still is already painted, and none of this
    runs unless the visitor is on a capable desktop that has not asked for
    reduced motion (CLAUDE.md > Budget). The sheet is requested after the page
    has loaded, so it never competes with the first load, and it replaces the
    still only once it has decoded. If it fails — no AVIF support — the still
    stays; there is deliberately no WebP fallback, which would break the lazy
    budget.

    Across a 6° yaw step this mark's silhouette barely moves (4px at 600px
    cells) — what changes between frames is the lighting. So the sprite carries
    yaw by cross-fading the two frames either side of the angle, and CSS adds
    a little rotation driven by the ABSOLUTE angle. Never by the angle left
    over after snapping to a frame: a leftover resets by a whole step at every
    frame boundary, and that reset is a visible snap. Pitch has no frames at
    all; CSS carries it, continuously.
  */
  const mark = document.querySelector<HTMLElement>('[data-mark]');
  const sheet = mark?.dataset.lazy;

  // The width query is the CSS two-column query, character for character, so
  // the sheet is only ever requested for the side-by-side layout.
  const capable = () =>
    matchMedia('(pointer: fine)').matches &&
    matchMedia('(min-width: 861px)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData &&
    (navigator.hardwareConcurrency || 8) > 4;

  if (mark && sheet && capable()) {
    const request = () => {
      const image = new Image();
      image.onload = () => start(mark, sheet);
      image.src = sheet;
    };

    // After load AND after the browser reports first contentful paint. `load`
    // alone is not enough — on a fast or cached load it fires before the first
    // paint — and neither is a double rAF, which proves a frame was produced
    // but not presented. Browsers without paint timing fall back to that.
    const painted = () => performance.getEntriesByType('paint').some((entry) => entry.name === 'first-contentful-paint');

    const afterFirstPaint = () => {
      if (painted()) return request();
      if (!PerformanceObserver.supportedEntryTypes?.includes('paint')) {
        return requestAnimationFrame(() => requestAnimationFrame(request));
      }
      const observer = new PerformanceObserver(() => {
        if (!painted()) return;
        observer.disconnect();
        request();
      });
      observer.observe({ type: 'paint', buffered: true });
    };

    if (document.readyState === 'complete') afterFirstPaint();
    else window.addEventListener('load', afterFirstPaint, { once: true });
  }

  function start(mark: HTMLElement, sheet: string) {
    const [layerA, layerB] = mark.querySelectorAll<HTMLElement>('[data-mark-layer]');
    if (!layerA || !layerB) return;

    // Frame angles come from the grid file. They are evenly spaced, so the
    // step and the range fall out of the first and last.
    const yaw: number[] = JSON.parse(mark.dataset.yaw ?? '[]');
    const first = yaw[0];
    const last = yaw[yaw.length - 1];
    const step = (last - first) / (yaw.length - 1);
    const maxYaw = Math.max(Math.abs(first), Math.abs(last));

    const MAX_PITCH = 14; // degrees. No pitch frames, so this range is CSS-only.
    const YAW_PARALLAX = 0.25; // the sprite carries yaw; CSS adds a little on top
    const PITCH_FACTOR = 0.8; // CSS carries pitch on its own
    const LERP = 0.14; // a slower ease holds each blend on screen longer
    const IDLE_MS = 2600;
    const SETTLED = 0.0005; // looser, and the last fraction of a degree lands as a step

    let pointerX = 0;
    let pointerY = 0;
    let movedAt = -Infinity;
    let x = 0; // current tilt, -1 (left / up) to 1 (right / down)
    let y = 0;
    let frame = 0;
    let idleTimer = 0;
    let pair = -1;

    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const cell = (index: number) => `${(index / (yaw.length - 1)) * 100}% 0%`;

    // Layer A shows the frame at or below the angle, layer B the one above it;
    // t is how far the angle has travelled between them, and the two are
    // weighted 1 − t and t (summed by plus-lighter, see the CSS).
    // Positive yaw turns the face to screen right; positive pitch tips the top
    // edge away — the mark looking down, toward a cursor low in the viewport.
    const render = (yawDeg: number, pitchDeg: number) => {
      const f = (Math.max(first, Math.min(last, yawDeg)) - first) / step;
      const i = Math.min(Math.floor(f), yaw.length - 2);
      const t = f - i;
      if (i !== pair) {
        layerA.style.backgroundPosition = cell(i);
        layerB.style.backgroundPosition = cell(i + 1);
        pair = i;
      }
      layerA.style.opacity = (1 - t).toFixed(4);
      layerB.style.opacity = t.toFixed(4);
      mark.style.transform =
        `perspective(1200px) rotateY(${(yawDeg * YAW_PARALLAX).toFixed(3)}deg) ` +
        `rotateX(${(pitchDeg * PITCH_FACTOR).toFixed(3)}deg)`;
    };

    const tick = (now: number) => {
      frame = 0;
      const idle = now - movedAt >= IDLE_MS;
      const targetX = idle ? 0 : clamp((pointerX / window.innerWidth) * 2 - 1);
      const targetY = idle ? 0 : clamp((pointerY / window.innerHeight) * 2 - 1);

      x += (targetX - x) * LERP;
      y += (targetY - y) * LERP;
      const settled = Math.abs(targetX - x) < SETTLED && Math.abs(targetY - y) < SETTLED;
      if (settled) {
        x = targetX;
        y = targetY;
      }

      render(x * maxYaw, y * MAX_PITCH);

      // The loop stops itself once it has converged. If it stopped away from
      // centre, one timer brings it back after the idle window.
      if (!settled) {
        frame = requestAnimationFrame(tick);
      } else if (!idle) {
        clearTimeout(idleTimer);
        idleTimer = window.setTimeout(wake, IDLE_MS - (now - movedAt));
      }
    };

    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    // Swap the still for the sheet in one task, already on the centre frame:
    // fill both layers, place them, then drop the still from under them.
    for (const layer of [layerA, layerB]) {
      layer.style.backgroundImage = `url(${sheet})`;
      layer.style.backgroundSize = `${yaw.length * 100}% 100%`;
    }
    render(0, 0);
    mark.style.backgroundImage = 'none';
    mark.classList.add('is-live');

    // The handler only records where the pointer is and when; all the work
    // happens in the frame loop.
    window.addEventListener(
      'mousemove',
      (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        movedAt = event.timeStamp;
        wake();
      },
      { passive: true }
    );
  }
</script>
