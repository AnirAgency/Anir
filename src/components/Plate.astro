---
import { resolveImage, resolveVideo } from '../lib/media';
import type { Media } from '../content/site';

/*
  A media slot that degrades honestly.

  It emits only the encoded variants that exist on disk, best format first, so
  a browser takes the smallest file it understands and never requests one that
  was never made. When nothing has been shot yet it renders a labelled plate
  naming what belongs there and in what format, so a gap reads as deliberate
  rather than broken.

  Every asset carries explicit width and height: CLAUDE.md forbids layout shift,
  and a plate that resizes when its video arrives is exactly that.
*/

interface Props {
  media: Media;
  /** CSS aspect-ratio for the slot, e.g. '16 / 10'. */
  ratio?: string;
  kind?: 'video' | 'image';
  class?: string;
}

const { media, ratio = '16 / 10', kind = 'video', class: className } = Astro.props;

const asset = kind === 'video' ? resolveVideo(media) : resolveImage(media);
---

<div class:list={['plate', className]} style={`--plate-ratio: ${ratio};`}>
  {
    kind === 'video' && asset.present && (
      <video
        class="plate__asset"
        poster={asset.fallback ?? undefined}
        width={media.width}
        height={media.height}
        aria-label={media.alt}
        muted
        playsinline
        loop
        autoplay
        preload="none"
      >
        {asset.sources.map((source) => (
          <source src={source.src} type={source.type} />
        ))}
      </video>
    )
  }

  {
    kind === 'image' && asset.present && (
      <picture>
        {asset.sources.map((source) => (
          <source srcset={source.src} type={source.type} />
        ))}
        <img
          class="plate__asset"
          src={asset.fallback ?? undefined}
          alt={media.alt}
          width={media.width}
          height={media.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    )
  }

  {
    !asset.present && (
      <div class="plate__pending">
        {media.label && <span class="plate__label t-mono-label">{media.label}</span>}
        {media.format && <span class="plate__format t-mono-label">{media.format}</span>}
      </div>
    )
  }
</div>

<style>
  .plate {
    position: relative;
    aspect-ratio: var(--plate-ratio);
    background: var(--plate);
    overflow: hidden;
  }

  .plate :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate__asset {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate__pending {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .plate__pending {
      padding: 0.65rem 0.75rem;
    }
  }
</style>
