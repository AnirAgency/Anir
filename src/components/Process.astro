---
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../content/site';

/*
  The process, as two columns either side of a spine: what the client gives
  (left) and what the studio does (right). Steps alternate sides so the eye
  zig-zags down the spine; every step appears once.

  Each step's circle and text bloom as the step crosses the middle of the
  viewport and shrink back as it leaves — CSS scroll-driven animation, no
  JavaScript. The base styles are the finished state: without support, under
  reduced motion and with JS off, every step is at full size and opacity and
  the spine rests at its calm 18% orange.
*/

const { intro, sides, items } = site.process;

/*
  Circle diameters, varied so the spine does not read as a progress bar.
  Presentation, not content — cycled, so any number of steps works.
*/
const DIAMETERS = [128, 80, 160, 96, 140, 72, 168, 88, 120];
---

<Section tone="dark" id="process" label={intro.label} heading={false}>
  <SectionHead intro={intro} id="process-title" />

  <div class="process">
    <div class="process__sides" aria-hidden="true">
      <p class="process__side process__side--client t-display-s">{sides.client}</p>
      <p class="process__side process__side--studio t-display-s">{sides.studio}</p>
    </div>

    <ol class="process__steps">
      {
        items.map((step, i) => (
          <li class:list={['step', `step--${step.side}`]} style={`--d: ${DIAMETERS[i % DIAMETERS.length]}px;`}>
            <span class="step__dot" aria-hidden="true" />
            <div class="step__text">
              <p class="step__meta t-mono-label">
                {String(i + 1).padStart(2, '0')} · {sides[step.side]}
              </p>
              <h3 class="step__title t-display-s">{step.title}</h3>
              <p class="step__desc t-mono-spec">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .process {
    /* The band the spine runs down: wide enough for the largest circle. */
    --spine-gap: 14rem;
  }

  .process__sides {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--spine-gap) minmax(0, 1fr);
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    color: var(--muted);
  }

  .process__side--client {
    grid-column: 1;
    text-align: right;
  }

  .process__side--studio {
    grid-column: 3;
  }

  .process__steps {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The spine. */
  .process__steps::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--hairline);
    background: var(--line);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--spine-gap) minmax(0, 1fr);
    align-items: center;
    min-height: 9rem;
  }

  /* The hairline tying each step to the spine. Not on the text, so it never scales. */
  .step::after {
    content: '';
    position: absolute;
    top: 50%;
    width: calc(var(--spine-gap) / 2);
    height: var(--hairline);
    background: var(--line);
  }

  .step--client::after {
    right: 50%;
  }

  .step--studio::after {
    left: 50%;
  }

  /*
    The circle: --orange throughout, varying only alpha. ::before is the calm
    18% that is always there; ::after adds 45% at the bloom's peak, which
    composites to ~55% (1 − 0.82 × 0.55). Opacity on a pseudo-element is
    compositor work, so the bloom costs nothing per frame. Overlapping
    neighbours stack into deeper orange.
  */
  .step__dot {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: var(--d);
    height: var(--d);
    margin-top: calc(var(--d) / -2);
    margin-left: calc(var(--d) / -2);
    border-radius: 50%;
  }

  .step__dot::before,
  .step__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--orange);
  }

  .step__dot::before {
    opacity: 0.18;
  }

  .step__dot::after {
    opacity: 0;
  }

  .step__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 26rem;
    grid-row: 1;
  }

  /* Each side grows away from the spine, never across it. */
  .step--client .step__text {
    grid-column: 1;
    justify-self: end;
    align-items: flex-end;
    text-align: right;
    transform-origin: right center;
  }

  .step--studio .step__text {
    grid-column: 3;
    justify-self: start;
    transform-origin: left center;
  }

  .step__meta,
  .step__desc {
    color: var(--muted);
  }

  /*
    The bloom. One named view timeline per step drives its circle, its glow
    and its text together. Scale and opacity only — never font-size, which
    would relayout every frame.
  */
  @supports (animation-timeline: view()) {
    .step {
      view-timeline: --process-step block;
    }

    .step__dot,
    .step__dot::after,
    .step__text {
      animation-timeline: --process-step;
      animation-range: entry 15% exit 85%;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-duration: auto;
    }

    .step__dot {
      animation-name: process-bloom-dot;
    }

    .step__dot::after {
      animation-name: process-bloom-glow;
    }

    .step__text {
      animation-name: process-bloom-text;
    }

    @keyframes process-bloom-dot {
      0% {
        scale: 0.45;
      }
      50% {
        scale: 1;
      }
      100% {
        scale: 0.45;
      }
    }

    @keyframes process-bloom-glow {
      0% {
        opacity: 0;
      }
      50% {
        opacity: 0.45;
      }
      100% {
        opacity: 0;
      }
    }

    @keyframes process-bloom-text {
      0% {
        scale: 0.88;
        opacity: 0.3;
      }
      50% {
        scale: 1;
        opacity: 1;
      }
      100% {
        scale: 0.88;
        opacity: 0.3;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step__dot,
    .step__dot::after,
    .step__text {
      animation: none;
    }
  }

  /*
    One column: the spine moves to the left edge and every step hangs off it
    in reading order. view() does not care about the layout, so the bloom is
    unchanged.
  */
  @media (max-width: 860px) {
    .process {
      --spine-x: 1.25rem;
      --spine-col: 3.5rem;
    }

    .process__sides {
      display: none;
    }

    .process__steps::before {
      left: var(--spine-x);
    }

    .step {
      grid-template-columns: var(--spine-col) minmax(0, 1fr);
      min-height: 0;
      padding-block: 1.5rem;
    }

    .step__dot {
      left: var(--spine-x);
      width: calc(var(--d) * 0.5);
      height: calc(var(--d) * 0.5);
      margin-top: calc(var(--d) * -0.25);
      margin-left: calc(var(--d) * -0.25);
    }

    .step--client .step__text,
    .step--studio .step__text {
      grid-column: 2;
      justify-self: start;
      align-items: flex-start;
      text-align: left;
      transform-origin: left center;
    }

    .step--client::after,
    .step--studio::after {
      left: var(--spine-x);
      right: auto;
      width: calc(var(--spine-col) - var(--spine-x));
    }
  }
</style>
