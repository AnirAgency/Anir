---
import Section from './Section.astro';
import { pictureOf } from '../lib/media';
import { placeholderMode } from '../lib/placeholders.mjs';
import type { Product } from '../content/site';

/*
  One big picture after a product's introduction: the screen's full width
  and height, the picture a little taller than its frame and moving through
  it slower than the page, so it has depth as it passes. Translate only, on
  the frame's view timeline; without it, under reduced motion and with JS
  off, the picture holds still, centred. On a phone, by the owner's
  direction, the screen's full width at its own shape, still — as the wall
  above is there.

  Shown only where there is something to show — the real encode, or its
  stand-in on dev and preview builds — so before the shoot, in production,
  the section is not emitted at all. A plain lazy <img> in the tile lane
  (CLAUDE.md > Budget).
*/

interface Props {
  product: Product;
}

const { product } = Astro.props;
const media = product.feature;
const pic = pictureOf(media, placeholderMode({ dev: import.meta.env.DEV }));
---

{
  pic && (
    <Section tone="dark" id="feature" label={product.name} layout="bleed">
      <div class="frame">
        <picture>
          {pic.sources.map((s) => (
            <source srcset={s.src} type={s.type} />
          ))}
          <img
            class="image"
            src={pic.src}
            width={media.width}
            height={media.height}
            alt={media.alt}
            loading="lazy"
            decoding="async"
            data-lane="tile"
          />
        </picture>
      </div>
    </Section>
  )
}

<style>
  .frame {
    position: relative;
    height: 100svh;
    overflow: clip;
    background: var(--plate);
  }

  .frame :global(picture) {
    display: contents;
  }

  /* A sixth taller than the frame, centred: room to travel. */
  .image {
    position: absolute;
    left: 0;
    top: -8.333%;
    display: block;
    width: 100%;
    height: 116.667%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .frame {
      height: auto;
    }

    .image {
      position: static;
      height: auto;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 861px) {
      .frame {
        view-timeline: --feature block;
      }

      .image {
        animation: pass linear both;
        animation-timeline: --feature;
        animation-range: cover 0% cover 100%;
      }
    }

    /* Against the page's direction, so it moves through the frame slower. */
    @keyframes pass {
      from {
        translate: 0 -7.143%;
      }
      to {
        translate: 0 7.143%;
      }
    }
  }
</style>
