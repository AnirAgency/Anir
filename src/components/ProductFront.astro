---
import Section from './Section.astro';
import { pictureOf } from '../lib/media';
import { placeholderMode } from '../lib/placeholders.mjs';
import { site, type Product } from '../content/site';

/*
  A product's front page. For a redesign, old and new in one frame at the
  content's full width, split by a line: the old site to the line's left,
  the new one to its right. The first time the frame comes into view the
  line sweeps across it once, from the right edge to the left, so the old
  site turns into the new; from then on the visitor holds it — drag the line
  or click where it should go, or focus it and use the arrow keys, Home and
  End. It runs all the way to either edge, and at an edge the arrow pointing
  off it goes. For a product built from nothing there is no old site, so the
  new front page alone, under its own heading.

  The line and its round handle are the control, so they are orange
  (CLAUDE.md > The orange rule); the handle is round by the owner's
  direction (CLAUDE.md > Layout). The old site lies in a clipping box over
  the new one; the box
  slides left while the picture inside slides back by as much, so only the
  box's edge moves — translate, on the compositor. On a touchscreen only a
  sideways drag moves the line; an upward one scrolls the page. The labels
  sit above the frame, never on the pictures.

  Without JS the line stands in the middle, half of each, and there is no
  handle to hold; under reduced motion there is no sweep, and it starts in
  the middle.

  The comparison needs both pictures there to show — the real encodes, or
  their stand-ins on dev and preview builds. With the new one alone, the
  section shows it as a product built new; with neither, before the shoot in
  production, it is not emitted. Plain lazy <img>s in the tile lane.
*/

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { compare, fresh } = site.products.pages;
const placeholders = placeholderMode({ dev: import.meta.env.DEV });
const after = { media: product.front.after, pic: pictureOf(product.front.after, placeholders) };
const before = product.front.before
  ? { media: product.front.before, pic: pictureOf(product.front.before, placeholders) }
  : null;
const mode = after.pic ? (before?.pic ? 'compare' : 'fresh') : null;
const head = mode === 'compare' ? compare : fresh;
const ratio = `${after.media.width} / ${after.media.height}`;
---

{
  mode && (
    <Section tone="dark" id="front" label={head.title} heading={false}>
      <header class="head">
        <h2 class="head__title t-display-l" data-reveal>{head.title}</h2>
        <p class="head__note t-mono-label" data-reveal>{head.note}</p>
      </header>

      {mode === 'compare' && (
        <p class="sides t-mono-label" aria-hidden="true">
          <span>{compare.before}</span>
          <span>{compare.after}</span>
        </p>
      )}

      <div class:list={['view', { compare: mode === 'compare' }]} data-compare={mode === 'compare' ? '' : undefined}>
        <div class="frame" style={`aspect-ratio: ${ratio};`}>
          <picture>
            {after.pic!.sources.map((s) => (
              <source srcset={s.src} type={s.type} />
            ))}
            <img
              class="shot"
              src={after.pic!.src}
              width={after.media.width}
              height={after.media.height}
              alt={after.media.alt}
              loading="lazy"
              decoding="async"
              data-lane="tile"
            />
          </picture>

          {mode === 'compare' && before && (
            <div class="old">
              <div class="old__inner">
                <picture>
                  {before.pic!.sources.map((s) => (
                    <source srcset={s.src} type={s.type} />
                  ))}
                  <img
                    class="shot"
                    src={before.pic!.src}
                    width={before.media.width}
                    height={before.media.height}
                    alt={before.media.alt}
                    loading="lazy"
                    decoding="async"
                    data-lane="tile"
                  />
                </picture>
              </div>
            </div>
          )}
        </div>

        {mode === 'compare' && (
          <Fragment>
            <span class="line" aria-hidden="true" />
            <span
              class="knob"
              role="slider"
              tabindex="0"
              aria-label={compare.control}
              aria-orientation="horizontal"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="arrow arrow--left" d="M10 7l-5 5 5 5" />
                <path class="arrow arrow--right" d="M14 7l5 5-5 5" />
              </svg>
            </span>
          </Fragment>
        )}
      </div>
    </Section>
  )
}

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .head__title {
    margin: 0;
  }

  .head__note {
    margin: 0;
    max-width: 44ch;
    color: var(--muted);
  }

  .sides {
    display: flex;
    justify-content: space-between;
    width: 81%;
    margin: clamp(2rem, 1rem + 3vw, 4rem) auto 0.9rem;
    color: var(--muted);
  }

  /* The frame at 81% of the content's width, centred, in the new site's
     shape — by the owner's direction; the full width on a phone. */
  .view {
    position: relative;
    width: 81%;
    margin: clamp(2rem, 1rem + 3vw, 4rem) auto 0;
  }

  @media (max-width: 860px) {
    .sides,
    .view {
      width: 100%;
    }
  }

  .sides + .view {
    margin-top: 0;
  }

  .frame {
    position: relative;
    overflow: clip;
    background: var(--plate);
  }

  .frame :global(picture) {
    display: contents;
  }

  .shot {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    --pos is the line's place, from the frame's left edge, set by the script
    below; 50% without it. The old site's box slides left by what is past
    the line, and its picture slides right by as much, so it holds still.
  */
  .compare {
    --pos: 50%;
  }

  .old,
  .old__inner {
    position: absolute;
    inset: 0;
  }

  .old {
    overflow: clip;
    translate: calc(var(--pos) - 100%) 0;
  }

  .old__inner {
    translate: calc(100% - var(--pos)) 0;
  }

  /* The line and the handle by `left`: two small boxes, laid out alone, and
     the handle can stand half past the frame at either edge. */
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--orange);
    translate: -50% 0;
    pointer-events: none;
  }

  .knob {
    position: absolute;
    top: 50%;
    left: var(--pos);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--orange);
    border-radius: 50%;
    background: var(--ink);
    translate: -50% -50%;
    cursor: ew-resize;
  }

  .knob svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--orange);
    stroke-width: 2;
  }

  .arrow {
    transition: opacity 0.2s ease;
  }

  .compare[data-edge='start'] .arrow--left,
  .compare[data-edge='end'] .arrow--right {
    opacity: 0;
  }

  /* With the script: the frame takes the pointer, sideways only on touch,
     and the pictures never start a drag of their own. */
  :global(html.js) .compare {
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  .compare .shot {
    pointer-events: none;
  }

  /* Without it, nothing to hold. */
  :global(html:not(.js)) .knob {
    display: none;
  }
</style>

<script>
  /*
    The comparison's line: one sweep from the old site to the new the first
    time the frame is mostly in view, then the visitor's. Pointer drag or
    click, and the keyboard on the handle. The sweep stops the moment the
    visitor takes the line.
  */
  const STEP: Record<string, number> = { ArrowLeft: -5, ArrowRight: 5, PageDown: -20, PageUp: 20 };

  for (const root of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const knob = root.querySelector<HTMLElement>('.knob');
    if (!knob) continue;

    let pos = 50;
    let sweep = 0;

    const set = (p: number) => {
      pos = Math.min(100, Math.max(0, p));
      root.style.setProperty('--pos', `${pos}%`);
      knob.setAttribute('aria-valuenow', String(Math.round(pos)));
      root.dataset.edge = pos <= 0.5 ? 'start' : pos >= 99.5 ? 'end' : '';
    };
    const take = () => cancelAnimationFrame(sweep);

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      set(100);
      const watch = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          watch.disconnect();
          const start = performance.now();
          const frame = (now: number) => {
            const t = Math.min(1, (now - start) / 1800);
            const eased = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
            set(100 - 100 * eased);
            if (t < 1) sweep = requestAnimationFrame(frame);
          };
          sweep = requestAnimationFrame(frame);
        },
        { threshold: 0.6 }
      );
      watch.observe(root);
    }

    const at = (x: number) => {
      const box = root.getBoundingClientRect();
      return ((x - box.left) / box.width) * 100;
    };

    // On touch the line waits to see which way the finger goes: up and down
    // is the page's, sideways is the line's.
    let drag: { id: number; x: number; y: number; live: boolean } | null = null;

    root.addEventListener('pointerdown', (event) => {
      take();
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, live: event.pointerType !== 'touch' };
      if (drag.live) {
        set(at(event.clientX));
        root.setPointerCapture(event.pointerId);
      }
    });

    root.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      if (!drag.live) {
        const dx = Math.abs(event.clientX - drag.x);
        if (dx < 8 || dx < Math.abs(event.clientY - drag.y)) return;
        drag.live = true;
        root.setPointerCapture(event.pointerId);
      }
      set(at(event.clientX));
    });

    const release = (event: PointerEvent) => {
      if (drag && event.pointerId === drag.id) drag = null;
    };
    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);

    knob.addEventListener('keydown', (event) => {
      if (event.key in STEP) set(pos + STEP[event.key]);
      else if (event.key === 'Home') set(0);
      else if (event.key === 'End') set(100);
      else return;
      take();
      event.preventDefault();
    });
  }
</script>
