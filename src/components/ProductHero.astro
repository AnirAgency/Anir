---
import Plate from './Plate.astro';
import Section from './Section.astro';
import { site, type Product } from '../content/site';

/*
  The top of a product's own page: the way back to all of them, the product's
  name and line, what it is and Anir's part in it — role, technology, year,
  and its site once it has a public one — then its screen, full width,
  unless the wall above has already shown it (`shot`).
*/

interface Props {
  product: Product;
  index: number;
  count: number;
  shot?: boolean;
}

const { product, index, count, shot = true } = Astro.props;
const { pages, specLabels } = site.products;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Section tone="dark" id="product" label={product.name} heading={false}>
  <div class="top">
    <a class="back t-mono-label" href="/products/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6"></path></svg>
      {pages.back}
    </a>

    <div class="intro">
      <header class="intro__head">
        <p class="intro__count t-mono-label" data-reveal>{pad(index + 1)} / {pad(count)}</p>
        <h1 class="intro__name t-display-xl" data-reveal>{product.name}</h1>
        <p class="intro__tagline t-serif-display" data-reveal>{product.tagline}</p>
      </header>

      <div class="intro__facts" data-reveal>
        <p class="intro__desc t-mono-body">{product.description}</p>
        <dl class="meta">
          {
            (['role', 'tech', 'year'] as const).map((key) => (
              <div class="meta__row">
                <dt class="t-mono-label">{specLabels[key]}</dt>
                <dd class="t-mono-spec">{product.spec[key]}</dd>
              </div>
            ))
          }
        </dl>
        {
          product.href && (
            <a class="visit t-mono-label" href={product.href} rel="noopener">
              {pages.visit}
            </a>
          )
        }
      </div>
    </div>
  </div>

  {
    shot && (
      <div class="shot" data-reveal>
        <Plate media={product.shot} ratio="16 / 10" kind="image" />
      </div>
    )
  }
</Section>

<style>
  /* The first thing on the page clears the fixed nav bar. */
  .top {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding-top: var(--header-h);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: start;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--orange);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
  }

  .intro__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .intro__count {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--muted);
  }

  /* The live product's mark: orange as a 2px rule, never as small text. */
  .intro__count::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    background: var(--orange);
  }

  .intro__tagline {
    margin: 0;
    max-width: 22ch;
  }

  .intro__facts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .intro__desc {
    margin: 0;
    color: var(--muted);
  }

  .meta {
    margin: 0;
    border-top: var(--hairline) solid var(--line);
  }

  .meta__row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .meta dt {
    color: var(--muted);
  }

  .meta dd {
    margin: 0;
  }

  .visit {
    align-self: start;
    color: var(--orange);
    text-decoration: none;
  }

  .shot {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
