---
import Plate from './Plate.astro';
import Section from './Section.astro';
import { site, type Product } from '../content/site';

/*
  A product's introduction, under the wall: the way back to all of them, then
  the product's name with its line beneath it in grey — one two-tone
  headline in the dark corner of the silk — then what it is, set large and
  centred, lighting up word by word as it passes through the screen, and
  Anir's part in it along a rule at the foot — role, technology, year, and
  its site once it has a public one. Then its screen, full width, unless the
  wall above has already shown it (`shot`).

  Behind it the orange silk of the home page's statement flows through the
  dark, dimmed and drifting very slowly (CLAUDE.md > The orange rule records
  the exception). A shade of the ground sits behind the words, and the foot
  fades to the ground, so no text is ever set on bright orange.

  Without scroll-driven animation, under reduced motion and with JS off, the
  words are simply there in full, and the silk holds still.
*/

interface Props {
  product: Product;
  index: number;
  count: number;
  shot?: boolean;
}

const { product, index, count, shot = true } = Astro.props;
const { pages, specLabels, statement } = site.products;
const { backdrop } = statement;
const pad = (n: number) => String(n).padStart(2, '0');
const words = product.description.split(' ');
---

<Section tone="dark" id="product" label={product.name} heading={false}>
  <div class="backdrop" aria-hidden="true">
    <img
      class="backdrop__image"
      src={backdrop.src}
      width={backdrop.width}
      height={backdrop.height}
      alt="" aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="top">
    <a class="back t-mono-label" href="/products/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6"></path></svg>
      {pages.back}
    </a>

    <header class="head">
      <p class="head__count t-mono-label" data-reveal>{pad(index + 1)} / {pad(count)}</p>
      <h1 class="head__name t-display-xl" data-reveal>{product.name}</h1>
      <p class="head__tagline t-serif-display" data-reveal>{product.tagline}</p>
    </header>
  </div>

  <p class="say t-serif-display" style={`--n: ${words.length}`}>
    {
      words.map((word, i) => (
        <span class="word" style={`--i: ${i}`}>
          {word}{' '}
        </span>
      ))
    }
  </p>

  <div class="foot" data-reveal>
    <dl class="meta">
      {
        (['role', 'tech', 'year'] as const).map((key) => (
          <div class="meta__cell">
            <dt class="t-mono-label">{specLabels[key]}</dt>
            <dd class="t-mono-spec">{product.spec[key]}</dd>
          </div>
        ))
      }
    </dl>
    {
      product.href && (
        <a class="visit t-mono-label" href={product.href} rel="noopener">
          {pages.visit}
        </a>
      )
    }
  </div>

  {
    shot && (
      <div class="shot" data-reveal>
        <Plate media={product.shot} ratio="16 / 10" kind="image" />
      </div>
    )
  }
</Section>

<style>
  /* Out to the section's edges, past the content's inset. */
  .backdrop {
    position: absolute;
    inset: calc(-1 * var(--section-pad-y)) calc(-1 * var(--inset-right)) calc(-1 * var(--section-pad-y))
      calc(-1 * var(--inset));
    overflow: clip;
    pointer-events: none;
  }

  /* Dimmed into the dark, so the silk is a glow behind the page rather than
     a picture on it. */
  .backdrop__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    opacity: 0.72;
  }

  /*
    The shade behind the words, in the section's own ground, and the foot
    fading to the ground under the facts: the silk can run anywhere, the text
    cannot sit on bright orange.
  */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 46% 26% at 50% 62%,
        color-mix(in srgb, var(--bg) 78%, transparent),
        color-mix(in srgb, var(--bg) 35%, transparent) 60%,
        transparent
      ),
      linear-gradient(to bottom, transparent 62%, var(--bg) 90%);
  }

  /* The first thing on the page clears the fixed nav bar. */
  .top {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding-top: var(--header-h);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: start;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--orange);
  }

  /* The two-tone headline: the name, then its line in grey right under it. */
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 40rem;
  }

  .head__count {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    color: var(--muted);
  }

  /* The live product's mark: orange as a 2px rule, never as small text. */
  .head__count::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    background: var(--orange);
  }

  .head__tagline {
    margin: 0;
    max-width: 18ch;
    color: var(--muted);
  }

  .say {
    position: relative;
    max-width: 46rem;
    margin: clamp(8rem, 4rem + 14vw, 18rem) auto 0;
    text-align: center;
    text-wrap: balance;
  }

  .foot {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: clamp(6rem, 3rem + 10vw, 13rem);
  }

  /* Anir's part, along a rule: three cells, label over value. */
  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 2vw, 3rem);
    margin: 0;
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--line);
  }

  .meta__cell {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .meta dt {
    color: var(--muted);
  }

  .meta dd {
    margin: 0;
  }

  .visit {
    align-self: start;
    color: var(--orange);
    text-decoration: none;
  }

  .shot {
    position: relative;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (max-width: 860px) {
    .backdrop {
      inset: calc(-1 * var(--section-pad-y)) calc(-1 * var(--inset-mobile));
    }

    /* A tall screen shows a slice of the image: the left one, dark at the
       top where the headline is, the silk running along the bottom — not the
       curl, which would put orange behind the headline and the way back. */
    .backdrop__image {
      object-position: 18% 50%;
    }

    .backdrop::after {
      background:
        radial-gradient(
          ellipse 85% 30% at 50% 60%,
          color-mix(in srgb, var(--bg) 80%, transparent),
          color-mix(in srgb, var(--bg) 40%, transparent) 65%,
          transparent
        ),
        linear-gradient(to bottom, transparent 62%, var(--bg) 90%);
    }

    .meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The silk breathes: a slow drift and swell, on the compositor. */
  @media (prefers-reduced-motion: no-preference) {
    .backdrop__image {
      animation: drift 26s ease-in-out infinite alternate;
    }
  }

  @keyframes drift {
    from {
      scale: 1;
      translate: 0 0;
    }
    to {
      scale: 1.07;
      translate: -2% -2%;
    }
  }

  /*
    The words: each comes up over its own stretch while the line moves from
    the lower part of the screen to the upper — together they take 40% of
    its passage, starting a fifth of the way in.
  */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .say {
        view-timeline: --about block;
        --step: calc(40% / var(--n));
      }

      .word {
        animation: word-in linear both;
        animation-timeline: --about;
        animation-range: cover calc(20% + var(--i) * var(--step)) cover calc(26% + var(--i) * var(--step));
      }
    }

    @keyframes word-in {
      from {
        opacity: 0.16;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
