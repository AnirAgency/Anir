---
import Plate from './Plate.astro';
import Section from './Section.astro';
import { site } from '../content/site';

/*
  The products page's list: one product after another, each its screen at
  full width, and under it, across a rule, its name on the left and what it
  is on the right. The whole card is the link to the product's own page.

  The screen settles as it comes into view — it arrives a little enlarged in
  its frame and eases to rest — and on hover it leans in a touch while the
  name turns orange. Orange on --ink passes AA at any size.
*/

const { pages, items } = site.products;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Section tone="dark" id="products-list" label={pages.title} heading={false}>
  <ol class="cards">
    {
      items.map((product, i) => (
        <li class="card">
          <a class="card__link" href={`/products/${product.id}/`}>
            <div class="card__shot">
              <Plate media={product.shot} ratio={`${product.shot.width} / ${product.shot.height}`} kind="image" />
            </div>
            <div class="card__row" data-reveal>
              <div class="card__head">
                <p class="card__index t-mono-label">
                  {pad(i + 1)} / {pad(items.length)} · {product.spec.year}
                </p>
                <h2 class="card__name t-display-l">{product.name}</h2>
              </div>
              <div class="card__about">
                <p class="card__tagline t-serif-italic">{product.tagline}</p>
                <p class="card__desc t-mono-body">{product.description}</p>
                <span class="card__open t-mono-label">{pages.open}</span>
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 2rem + 6vw, 9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card__link {
    display: block;
    color: var(--fg);
    text-decoration: none;
  }

  .card__shot :global(.plate__asset) {
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card__link:hover .card__shot :global(.plate__asset),
  .card__link:focus-visible .card__shot :global(.plate__asset) {
    transform: scale(1.025);
  }

  /* Name on the left, what it is on the right, across a rule. */
  .card__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-top: var(--hairline) solid var(--line);
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card__index,
  .card__desc {
    margin: 0;
    color: var(--muted);
  }

  /* The live product's mark: orange as a 2px rule, never as small text. */
  .card__index {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .card__index::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    background: var(--orange);
  }

  .card__name,
  .card__tagline {
    margin: 0;
  }

  .card__name {
    transition: color 0.3s ease;
  }

  .card__about {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  .card__open {
    margin-top: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .card__link:hover .card__name,
  .card__link:focus-visible .card__name {
    color: var(--orange);
  }

  .card__link:hover .card__open,
  .card__link:focus-visible .card__open {
    border-color: var(--orange);
  }

  @media (max-width: 860px) {
    .card__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /*
    The settle: scale, while hover uses transform, so the two compose. Timed
    on the frame by name — the plate clips with overflow: hidden, which makes
    it a scroll container, and a bare view() on the image would bind to it.
  */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .card__shot {
        view-timeline: --card block;
      }

      .card__shot :global(.plate__asset) {
        animation: settle linear both;
        animation-timeline: --card;
        animation-range: entry 0% cover 50%;
      }
    }

    @keyframes settle {
      from {
        scale: 1.12;
      }
      to {
        scale: 1;
      }
    }
  }
</style>
