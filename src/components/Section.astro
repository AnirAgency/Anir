---
/*
  The alternating section wrapper. Sections run light, dark, light, dark — never
  two of the same in a row, except the showreel and process, both dark by
  decision (CLAUDE.md > Layout).

  Its real job is to set the tone variables. Everything inside a section reads
  --bg / --fg / --muted / --line / --plate and never touches --ink or --paper
  directly, which is what lets a section flip tone without any child knowing.
*/

interface Props {
  tone: 'dark' | 'light';
  id: string;
  /** Shown by the rail as the current-section marker. Mongolian, from site.ts. */
  label?: string;
  /*
    default — normal block: inset, vertical rhythm, corner ticks.
    hero    — fills the viewport and centres its contents.
    strip   — thin, full-bleed, no ticks. The marquee.
    bleed   — full-bleed, no padding, no ticks, and no overflow clipping:
              overflow: hidden would make the section a scroll container and
              freeze every view() timeline inside it. The showreel mosaic.
  */
  layout?: 'default' | 'hero' | 'strip' | 'bleed';
  /**
   * Whether to emit the visually-hidden <h2> naming the section. Turn it off
   * where the section supplies its own heading — the hero, which owns the h1.
   */
  heading?: boolean;
  /** Drop the top rule when two sections should read as one block. */
  seam?: boolean;
  class?: string;
}

const {
  tone,
  id,
  label,
  layout = 'default',
  heading = true,
  seam = false,
  class: className,
} = Astro.props;

const showHeading = heading && Boolean(label);
const ticks = layout !== 'strip' && layout !== 'bleed';
---

<section
  id={id}
  class:list={['section', `section--${tone}`, `section--${layout}`, { 'section--seam': seam }, className]}
  data-section
  data-label={label}
  aria-labelledby={showHeading ? `${id}-label` : undefined}
  aria-label={!showHeading && label ? label : undefined}
>
  {showHeading && <h2 id={`${id}-label`} class="visually-hidden">{label}</h2>}

  {
    ticks && (
      <Fragment>
        {/* Blueprint corner ticks. Decorative — never announced. */}
        <span class="section__tick section__tick--tl" aria-hidden="true" />
        <span class="section__tick section__tick--tr" aria-hidden="true" />
      </Fragment>
    )
  }

  <div class="section__inner">
    <slot />
  </div>

  {/*
    The bottom ticks come after the content on purpose. They sit on the
    section's bottom edge, and that edge moves while the section is still
    parsing — if the HTML stalls mid-section, ticks parsed up front would be
    painted at a provisional bottom and then jump. Parsed last, they first
    appear where they stay.
  */}
  {
    ticks && (
      <Fragment>
        <span class="section__tick section__tick--bl" aria-hidden="true" />
        <span class="section__tick section__tick--br" aria-hidden="true" />
      </Fragment>
    )
  }
</section>

<style>
  .section {
    --section-pad-y: clamp(3.5rem, 2.2rem + 5.3vw, 7.5rem);
    --tick: 9px;

    position: relative;
    background: var(--bg);
    color: var(--fg);
    padding-block: var(--section-pad-y);
    padding-left: var(--inset);
    padding-right: var(--inset-right);
    /* Anchor jumps — Lenis honours this too — land below the solid nav bar. */
    scroll-margin-top: var(--header-h);
  }

  .section--dark {
    --bg: var(--ink);
    --fg: var(--paper);
    --muted: var(--dim);
    --line: var(--line-dark);
    --plate: var(--ink-2);
  }

  .section--light {
    --bg: var(--paper);
    --fg: var(--ink);
    --muted: var(--dim-2);
    --line: var(--line-light);
    --plate: var(--paper-2);
  }

  /*
    svh, not vh: the mobile URL bar must not push the hero taller than the screen.

    Content is top-aligned, never centred. Centring against the content's own
    height has no stable answer until all of that content exists: if the HTML
    stalls mid-hero while the CSS has landed, the browser paints and centres
    whatever has parsed, then re-centres when the rest arrives — measured at
    CLS 0.1155 at 1440 and 0.2976 at 390.
  */
  .section--hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    /* The first thing on the page must clear the solid nav bar. */
    padding-top: max(var(--section-pad-y), calc(var(--header-h) + 1.5rem));
  }

  /*
    Two-column hero. The top padding is set by two things, measured across
    common desktop viewports from 1024 × 768 to 2560 × 1440:

    - The 3D N's glass must clear the nav labels by at least 64px, in every
      frame of the tilt. 10rem gives 121px. The section rhythm is not enough:
      it shrinks to ~90px of padding at 1024–1280 wide.
    - The product-card row is cut wherever that lands — a cut row is the
      scroll signal, not a defect — but never by a few pixels either way, a
      sliver that reads as a mistake. At 10rem it is cut 56% at 1440 × 900 and
      34% at 1360 × 932, and everywhere else it is clearly cut, wholly in view
      or wholly below the fold. 9.5rem leaves 7px of it showing at 1280 × 800.
  */
  @media (min-width: 861px) {
    .section--hero {
      padding-top: 10rem;
    }
  }

  .section--strip {
    padding-block: 0;
    padding-inline: 0;
    overflow: hidden;
  }

  .section--bleed {
    padding-block: 0;
    padding-inline: 0;
  }

  /* The boundary rule between two sections. */
  .section::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--hairline);
    background: var(--line);
  }

  .section--seam::before {
    display: none;
  }

  /*
    Corner ticks — two 1px arms meeting at each corner, inset from the edge so
    they read as registration marks rather than a broken border.
  */
  .section__tick {
    position: absolute;
    width: var(--tick);
    height: var(--tick);
    pointer-events: none;
  }

  .section__tick::before,
  .section__tick::after {
    content: '';
    position: absolute;
    background: var(--line);
  }

  .section__tick::before {
    inset-inline: 0;
    height: var(--hairline);
  }

  .section__tick::after {
    inset-block: 0;
    width: var(--hairline);
  }

  .section__tick--tl {
    top: var(--tick);
    left: var(--tick);
  }
  .section__tick--tl::before {
    top: 0;
  }
  .section__tick--tl::after {
    left: 0;
  }

  .section__tick--tr {
    top: var(--tick);
    right: var(--tick);
  }
  .section__tick--tr::before {
    top: 0;
  }
  .section__tick--tr::after {
    right: 0;
  }

  .section__tick--bl {
    bottom: var(--tick);
    left: var(--tick);
  }
  .section__tick--bl::before {
    bottom: 0;
  }
  .section__tick--bl::after {
    left: 0;
  }

  .section__tick--br {
    bottom: var(--tick);
    right: var(--tick);
  }
  .section__tick--br::before {
    bottom: 0;
  }
  .section__tick--br::after {
    right: 0;
  }

  .section__inner {
    position: relative;
  }

  .section--hero .section__inner {
    width: 100%;
  }

  @media (max-width: 860px) {
    .section {
      padding-left: var(--inset-mobile);
      padding-right: var(--inset-mobile);
      --tick: 7px;
    }

    .section--strip,
    .section--bleed {
      padding-inline: 0;
    }
  }
</style>
