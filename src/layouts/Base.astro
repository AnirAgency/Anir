---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

import Header from '../components/Header.astro';
import Rail from '../components/Rail.astro';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /** The styleguide renders its own chrome-free page. */
  chrome?: boolean;
  /** A review page, like /v2: kept out of search, and pointing at the home
   *  page as the real one. */
  noindex?: boolean;
  /** False on the products pages, which do not hold the home page's
   *  sections: the nav's anchors lead back to it. */
  home?: boolean;
  /** False on a page with no address of its own — the 404 page — so it names
   *  no canonical URL and no og:url. */
  canonical?: boolean;
}

const { title, description, chrome = true, noindex = false, home = true, canonical: hasCanonical = true } = Astro.props;

const pageTitle = title ?? site.meta.title;
const pageDescription = description ?? site.meta.description;
const canonical = hasCanonical ? new URL(noindex ? '/' : Astro.url.pathname, Astro.site).href : null;
const ogImage = site.meta.ogImage ? new URL(site.meta.ogImage, Astro.site).href : null;

/*
  The studio's records for search engines — on the home page only, the
  page they describe, and never on a page kept out of search. Built from
  site.ts so they cannot drift from the visible copy.

    Organization       who Anir is: name, logo, contact, its own accounts.
    ProfessionalService  the business — a LocalBusiness subtype, chosen
                       because there is no shopfront to walk into and the
                       services are the point. Its address is the city and
                       country only: a street address waits on a real one.
    WebSite            carries inLanguage: "mn" — schema.org gives that
                       property to a site or a page, not to an organization.

  sameAs appears only once site.meta.sameAs holds the real accounts.
*/
const base = Astro.site?.href ?? '/';
const organizationId = `${base}#organization`;
const records = home && !noindex;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Anir',
    legalName: 'Анир ХХК',
    url: base,
    logo: new URL(site.meta.logo, Astro.site).href,
    email: site.contact.email,
    foundingDate: site.meta.founded,
    knowsLanguage: 'mn',
    ...(site.meta.sameAs.length ? { sameAs: site.meta.sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${base}#business`,
    name: 'Anir',
    url: base,
    ...(ogImage ? { image: ogImage } : {}),
    logo: new URL(site.meta.logo, Astro.site).href,
    description: site.meta.description,
    email: site.contact.email,
    parentOrganization: { '@id': organizationId },
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.meta.locality,
      addressCountry: site.meta.countryCode,
    },
    areaServed: site.meta.country,
    knowsLanguage: 'mn',
    makesOffer: site.services.items.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: item.name },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${base}#website`,
    name: 'Anir',
    url: base,
    inLanguage: 'mn',
    publisher: { '@id': organizationId },
  },
];
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08090B" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="mn_MN" />
    <meta property="og:site_name" content="Anir" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={site.hero.logoAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/*
      Two faces only: the nav (JetBrains Mono 400) and the italic tagline line
      (PT Serif 400 italic) — the two a visitor reads the moment the page
      paints, at every width, and the two that moved on swap before their
      fallbacks were metric-matched. Everything else, the tagline's roman line
      included, comes via the stylesheet behind a matched fallback (fonts.css).

      Each preload competes with the render-blocking CSS for bandwidth.
      Measured on Slow 4G with 4× CPU, uncached, FCP median: 1148ms before;
      1236ms preloading PT Serif 400 as well; 1084ms with these two.
    */}
    <link rel="preload" href="/fonts/jetbrainsmono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ptserif-400-italic.woff2" as="font" type="font/woff2" crossorigin />

    {records && jsonLd.map((record) => <script type="application/ld+json" set:html={JSON.stringify(record)} />)}

    <slot name="head" />

    {/*
      Runs before the body paints, so [data-reveal] is hidden before it can
      flash. Inline and tiny on purpose: as an external file it would race the
      first paint. Adds nothing when the visitor asked for reduced motion, which
      is what keeps that page completely static.

      .shimmer lets the film grain boil (base.css): a fine pointer, no
      saveData, more than four cores — the same gates as the hero mark. It
      runs as long as the page is open, so a phone would pay for it in
      battery; phones get the same grain, still.

      .js is for layouts that a script will drive, like the products reel, so
      they take their final shape at the first paint instead of when the
      script arrives — which, with the stream stalled, could be seconds later.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        if (matchMedia('(pointer: fine)').matches && !navigator.connection?.saveData && (navigator.hardwareConcurrency || 8) > 4) {
          document.documentElement.classList.add('shimmer');
        }
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link t-mono-label" href="#main">{site.chrome.skipToContent}</a>

    {chrome && <Header home={home} />}
    {chrome && <Rail />}

    <main id="main">
      <slot />
    </main>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
