---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

import Header from '../components/Header.astro';
import Rail from '../components/Rail.astro';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /** The styleguide renders its own chrome-free page. */
  chrome?: boolean;
}

const { title, description, chrome = true } = Astro.props;

// site.ts is still largely empty; fall back so the build stays valid.
const pageTitle = title ?? site.meta.title ?? '';
const pageDescription = description ?? site.meta.description ?? '';
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <slot name="head" />

    {/*
      Runs before the body paints, so [data-reveal] is hidden before it can
      flash. Inline and tiny on purpose: as an external file it would race the
      first paint. Adds nothing when the visitor asked for reduced motion, which
      is what keeps that page completely static.
    */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link t-mono-label" href="#main">{site.chrome.skipToContent}</a>

    {chrome && <Header />}
    {chrome && <Rail />}

    <main id="main">
      <slot />
    </main>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
