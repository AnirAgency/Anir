---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showreel from '../components/Showreel.astro';
import ProductsIntro from '../components/ProductsIntro.astro';
import ProductsBeam from '../components/ProductsBeam.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { placeholderMode } from '../lib/placeholders.mjs';

/*
  /v2 — the home page with the products statement on the light ground: the
  same silk on --paper instead of the dark. Everything else as on /, to
  compare the two.

  A review page, so it is built where the placeholder media is — dev and
  preview builds (src/lib/placeholders.mjs) — and never in production. It
  keeps itself out of search and names / as the real page.
*/
export function getStaticPaths() {
  return placeholderMode({ dev: import.meta.env.DEV }) ? [{ params: { variant: 'v2' } }] : [];
}
---

<Base noindex>
  <Hero />
  <Marquee />
  <Showreel />
  <ProductsIntro light />
  <ProductsBeam />
  <Process />
  <Services />
  <Contact />
  <Footer />
</Base>
