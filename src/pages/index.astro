---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showreel from '../components/Showreel.astro';
import Process from '../components/Process.astro';
import Disciplines from '../components/Disciplines.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  {/*
    Tones: hero and marquee dark, then the showreel and the process — both
    dark, told apart by density: the mosaic is full to the edges, the process
    sparse. The showreel renders only once real media exists. From services on
    the page alternates again.
  */}
  <Hero />
  <Marquee />
  <Showreel />
  <Process />
  <Disciplines />
  <Work />
  <Contact />
  <Footer />
</Base>
