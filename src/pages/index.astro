---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showreel from '../components/Showreel.astro';
import Disciplines from '../components/Disciplines.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  {/*
    The process sits beside the form: it answers "what happens if I contact
    you", which a visitor only asks once they might. Where two darks meet —
    the showreel after the hero, the process after work — one is full and one
    sparse (CLAUDE.md > Layout). The showreel renders only once real media
    exists.
  */}
  <Hero />
  <Marquee />
  <Showreel />
  <Disciplines />
  <Work />
  <Process />
  <Contact />
  <Footer />
</Base>
