---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductIndex from '../../components/ProductIndex.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../content/site';

/*
  /products/ — Anir's own products, one large card each, every card the way
  into that product's own page. Then the way to the enquiry form.
*/

const { pages } = site.products;
---

<Base title={`${pages.title} — Anir`} description={pages.intro} home={false}>
  <PageHead />
  <ProductIndex />
  <ContactCta tone="dark" />
  <Footer />
</Base>
