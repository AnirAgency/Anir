{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anir",
  "compatibility_date": "2026-10-26",

  // The Worker answers /api/* and hands everything else to the static assets
  // in dist/. Requests that match a file are served without waking it; a URL
  // that matches nothing gets dist/404.html with status 404.
  //
  // run_worker_first pins /api/* to the Worker. Without it, a navigation that
  // matches no file is answered by the asset layer before the Worker runs —
  // and a no-JS form post to /api/enquiry IS a navigation, so the 404 page
  // would answer it and the enquiry would be lost.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // The site's address: aniragency.mn, the Worker's Custom Domain. On deploy
  // Cloudflare creates its DNS record and certificate itself — none is added
  // by hand. It must be the host src/lib/site-url.mjs names: `npm run seo`
  // fails the build otherwise, and checks this host is never sent noindex.
  //
  // www is NOT a second Custom Domain: that would give every page two
  // addresses where the canonical names one. A Redirect Rule in the zone
  // (Rules > Redirect Rules) sends www.aniragency.mn/* to
  // https://aniragency.mn/${1} with a 301, over a proxied www DNS record —
  // a zone setting, not this file's; README > The domain.
  "routes": [{ "pattern": "aniragency.mn", "custom_domain": true }],

  // anir.<account>.workers.dev stays on: the base for preview URLs, and a
  // copy of the site that always says noindex (dist/_headers, the Worker).
  "workers_dev": true,

  // Every non-production build gets its own URL — each PR is reviewable live.
  "preview_urls": true,
  "observability": { "enabled": true },

  // Public, and in every Supabase client, so it is not a secret. The
  // service_role key IS: `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
  // BUILD_REPORT_SECRET is how the build reports on itself to the admin
  // (worker/builds.ts): `npx wrangler secret put BUILD_REPORT_SECRET`, and the
  // same value as a build secret (Settings > Build > Variables and secrets).
  // It can write one status row and nothing else.
  "vars": {
    "SUPABASE_URL": "https://tyrzajpotvtirfjmacfm.supabase.co"
  },

  "kv_namespaces": [
    // The enquiry rate limiter. Without this binding it fails OPEN — the form
    // works but is unthrottled — so a missing binding is silent. Do not remove.
    { "binding": "RATE_LIMIT", "id": "9f75dcfba28142c8a3df1b8f47ab7bfc" },
    // Where an enquiry waits when Supabase will not take it. Without it a
    // failed write loses the enquiry. Do not remove.
    { "binding": "ENQUIRY_BUFFER", "id": "f88d8fe8986e4273a99c041c8e1da8e3" }
  ],

  // Drains ENQUIRY_BUFFER into Supabase (worker/index.ts > scheduled).
  "triggers": { "crons": ["*/15 * * * *"] },

  // Notification secrets, set with `npx wrangler secret put`, never here:
  // RESEND_API_KEY + NOTIFY_EMAIL for email, or TELEGRAM_BOT_TOKEN +
  // TELEGRAM_CHAT_ID for a Telegram chat. Either, both, or — until set — a
  // warning in the logs on every enquiry.

  // Pull-request builds run `wrangler preview`, and a Preview inherits none
  // of the vars or bindings above — only what is listed here. So a preview
  // has no database (an empty URL, and no secrets are set for previews) and
  // KV namespaces of its own: an enquiry sent from a preview waits in the
  // preview buffer and expires there after 30 days. Previews run no crons, so
  // nothing drains it into the production table, and nobody is notified.
  "previews": {
    "vars": { "SUPABASE_URL": "" },
    "kv_namespaces": [
      { "binding": "RATE_LIMIT", "id": "33f352be599f470aa066d51b930afad1" },
      { "binding": "ENQUIRY_BUFFER", "id": "308a7466ea7340d0b01f136f90a1e910" }
    ]
  }
}
